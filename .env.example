# Credenciais da Nova API Deriv (developers.deriv.com)
DERIV_API_TOKEN=seu_personal_access_token_aqui
DERIV_APP_ID=seu_app_id_aqui
DERIV_ACCOUNT_ID=sua_conta_demo_ou_real_aqui

# Seleção Dinâmica do Ativo Mais Seguro (Elege automaticamente o ativo com maior sobrevivência)
AUTO_SELECT_BEST_ASSET=true
SYMBOL=R_10

# Parâmetros Operacionais do Acumulador
GROWTH_RATE=0.05
STAKE_AMOUNT=1.00
EXIT_TICKS=6
TAKE_PROFIT_USD=0.35

# Gestão de Risco Rigorosa (Hard Stops Diários)
DAILY_STOP_LOSS_USD=2.00
DAILY_TAKE_PROFIT_USD=2.00
MAX_CONSECUTIVE_LOSSES=2
